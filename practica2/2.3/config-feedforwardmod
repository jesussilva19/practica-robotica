# NEAT params for Robobo P2.2/2.3

[NEAT]
fitness_criterion     = max
fitness_threshold     = 999999999
pop_size              = 12
reset_on_extinction   = False

[DefaultGenome]
# activation
activation_default      = relu
activation_mutate_rate  = 0.30
activation_options      = relu tanh sigmoid

# aggregation
aggregation_default     = sum
aggregation_mutate_rate = 0.0
aggregation_options     = sum

# bias
bias_init_mean          = 0.0
bias_init_stdev         = 2.0
bias_max_value          = 30.0
bias_min_value          = -30.0
bias_mutate_power       = 3.0
bias_mutate_rate        = 0.95
bias_replace_rate       = 0.20

# compatibility
compatibility_disjoint_coefficient = 1.0
compatibility_weight_coefficient   = 0.5

# connections
conn_add_prob           = 0.80
conn_delete_prob        = 0.60
enabled_default         = True
enabled_mutate_rate     = 0.10

feed_forward            = True
initial_connection      = full_direct

# nodes
node_add_prob           = 0.50
node_delete_prob        = 0.25

# network size 
num_hidden              = 4
num_inputs              = 5
num_outputs             = 8

# response 
response_init_mean      = 1.0
response_init_stdev     = 0.1
response_max_value      = 30.0
response_min_value      = -30.0
response_mutate_power   = 0.8
response_mutate_rate    = 0.30
response_replace_rate   = 0.05

# weights
weight_init_mean        = 0.0
weight_init_stdev       = 2.0
weight_max_value        = 30
weight_min_value        = -30
weight_mutate_power     = 3.5
weight_mutate_rate      = 0.98
weight_replace_rate     = 0.25

[DefaultSpeciesSet]
compatibility_threshold = 3.0

[DefaultStagnation]
species_fitness_func = max
max_stagnation       = 15
species_elitism      = 2

[DefaultReproduction]
elitism            = 2
survival_threshold = 0.2
min_species_size   = 1







